  "lines": [
    {
      "id": "b01",
      "file": "vo3/b01.mp3",
      "from": 0,
      "to": 4.007,
      "at": 0.35,
      "end": 4.357,
      "text": "Bom Paladar, Restaurante e Bar! O sabor que Quelimane ADORA!"
    },
    {
      "id": "b02",
      "file": "vo3/b02.mp3",
      "from": 0.057,
      "to": 6.878,
      "at": 4.457,
      "end": 11.278,
      "text": "Na Rua Robert Mugabe, aberto até à meia-noite, com nota quatro vírgula três no Google!"
    },
    {
      "id": "b03",
      "file": "vo3/b03.mp3",
      "from": 0.097,
      "to": 9.325,
      "at": 11.378,
      "end": 20.606,
      "text": "Pizza Double Stack, duas camadas de puro sabor: MIL meticais! Pizza Seafood, com lula e camarão: setecentos!"
    },
    {
      "id": "b04",
      "file": "vo3/b04.mp3",
      "from": 0.052,
      "to": 6.609,
      "at": 20.706,
      "end": 27.263,
      "text": "Tagliatelle Carbonara, bem cremosa: quinhentos e cinquenta! Lasanha de carne moída: setecentos!"
    },
    {
      "id": "b05",
      "file": "vo3/b05.mp3",
      "from": 0.06,
      "to": 5.329,
      "at": 27.363,
      "end": 32.632,
      "text": "Aparelhada de mariscos, com lula, camarão e lagosta: a partir de mil e quinhentos meticais!"
    },
    {
      "id": "b06",
      "file": "vo3/b06.mp3",
      "from": 0,
      "to": 5.956,
      "at": 32.732,
      "end": 38.688,
      "text": "Bife grelhado com molho demi-glace: mil e cem! Meia galinha cafreal: oitocentos!"
    },
    {
      "id": "b07",
      "file": "vo3/b07.mp3",
      "from": 0.105,
      "to": 5.329,
      "at": 38.788,
      "end": 44.012,
      "text": "Para petiscar: asinhas crocantes e pão de alho com queijo, a partir de trezentos e cinquenta!"
    },
    {
      "id": "b08",
      "file": "vo3/b08.mp3",
      "from": 0.085,
      "to": 5.486,
      "at": 44.112,
      "end": 49.513,
      "text": "E no bar: Mojito a trezentos e Piña Colada a quatrocentos e cinquenta!"
    },
    {
      "id": "b09",
      "file": "vo3/b09.mp3",
      "from": 0,
      "to": 3.553,
      "at": 49.613,
      "end": 53.166,
      "text": "São mais de cento e trinta pratos e bebidas no nosso cardápio!"
    },
    {
      "id": "b10",
      "file": "vo3/b10.mp3",
      "from": 0,
      "to": 11.389,
      "at": 53.266,
      "end": 64.655,
      "text": "Veja o menu completo no nosso site e reserve a sua mesa pelo WhatsApp: oitenta e sete... cento e oitenta e cinco... quarenta e quatro... dezassete! Bom Paladar: reserve JÁ!"
    }
  ],
