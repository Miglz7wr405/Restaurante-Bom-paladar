  "lines": [
    {
      "id": "b01",
      "file": "vo4/b01.mp3",
      "from": 0,
      "to": 4.007,
      "at": 0.35,
      "end": 4.357,
      "text": "Bom Paladar, Restaurante e Bar! O sabor que Quelimane ADORA!"
    },
    {
      "id": "b02",
      "file": "vo4/b02.mp3",
      "from": 0.057,
      "to": 5.028,
      "at": 4.457,
      "end": 9.428,
      "text": "Na Rua Robert Mugabe, com nota quatro vírgula três no Google!"
    },
    {
      "id": "b03",
      "file": "vo4/b03.mp3",
      "from": 0,
      "to": 6.531,
      "at": 9.528,
      "end": 16.059,
      "text": "Buffet à vontade, com bebidas e sobremesa incluídas: a partir de MIL E QUINHENTOS meticais por pessoa!"
    },
    {
      "id": "b04",
      "file": "vo4/b04.mp3",
      "from": 0.054,
      "to": 5.878,
      "at": 16.159,
      "end": 21.982,
      "text": "Com camarão e lulas: DOIS MIL! E com lagosta e camarão tigre: DOIS MIL E OITOCENTOS!"
    },
    {
      "id": "b05",
      "file": "vo4/b05.mp3",
      "from": 0,
      "to": 6.426,
      "at": 22.082,
      "end": 28.508,
      "text": "Chamuças, bife na panela, galinha à zambeziana, peixe grelhado e mousse de malambe… tudo no buffet!"
    },
    {
      "id": "b06",
      "file": "vo4/b06.mp3",
      "from": 0.052,
      "to": 7.079,
      "at": 28.608,
      "end": 35.635,
      "text": "Tagliatelle Carbonara, bem cremosa: novecentos e cinquenta! Lasanha de carne moída: setecentos!"
    },
    {
      "id": "b07",
      "file": "vo4/b07.mp3",
      "from": 0.085,
      "to": 5.486,
      "at": 35.735,
      "end": 41.136,
      "text": "E no bar: Mojito a trezentos e Piña Colada a quatrocentos e cinquenta!"
    },
    {
      "id": "b08",
      "file": "vo4/b08.mp3",
      "from": 0,
      "to": 5.799,
      "at": 41.236,
      "end": 47.035,
      "text": "Bom Paladar Intense Girl: quatrocentos! Tequila Sunrise: quinhentos!"
    },
    {
      "id": "b09",
      "file": "vo4/b09.mp3",
      "from": 0,
      "to": 5.642,
      "at": 47.135,
      "end": 52.777,
      "text": "Vinhos, cervejas, gins e whiskies: são mais de cento e vinte pratos e bebidas no nosso cardápio!"
    },
    {
      "id": "b10",
      "file": "vo4/b10.mp3",
      "from": 0,
      "to": 9.038,
      "at": 52.877,
      "end": 61.915,
      "text": "Veja o menu completo no nosso site e reserve a sua mesa pelo WhatsApp: [87 185 44 17 no ecrã] Bom Paladar: reserve JÁ!"
    }
  ],
